{
    "sync": {
        "peers": [
            {
                "type": "couchdb",
                "name": "remote",
                "group": "main",
                "url": "http://localhost:5984",
                "database": "note-test",
                "username": "admin",
                "password": "change-me",
                "passphrase": "my-e2ee-passphrase",
                "obfuscatePassphrase": "my-e2ee-passphrase",
                "baseDir": "",
                "useRemoteTweaks": true
            },
            {
                "type": "storage",
                "name": "local",
                "group": "main",
                "baseDir": "./vault",
                "scanOfflineChanges": true,
                "ignorePatterns": [
                    ".trash/",
                    ".obsidian/",
                    ".git/",
                    "node_modules/"
                ]
            }
        ]
    },
    "state": {
        "file": "~/.livesync/state.json"
    },
    "logging": {
        "level": "info",
        "file": "",
        "maxSize": 10
    },
    "api": {
        "listen": "localhost:2324"
    },
    "tray": {
        "enable": true,
        "autostart": false
    }
}
